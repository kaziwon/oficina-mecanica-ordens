apiVersion: batch/v1
kind: Job
metadata:
  name: "${job_name}"
  namespace: "${namespace}"
spec:
  backoffLimit: 1
  activeDeadlineSeconds: 300
  template:
    metadata:
      labels: {app: migrations}
    spec:
      automountServiceAccountToken: false
      restartPolicy: Never
      securityContext: {runAsNonRoot: true, runAsUser: 1654, runAsGroup: 1654}
      containers:
        - name: migrations
          image: "${api_image}"
          imagePullPolicy: IfNotPresent
          envFrom:
            - configMapRef: {name: api-config}
            - secretRef: {name: api-secrets}
          env:
            - {name: CORECLR_ENABLE_PROFILING, value: '0'}
            - {name: NEW_RELIC_AGENT_ENABLED, value: 'false'}
            - {name: Database__ApplyMigrations, value: 'true'}
            - {name: Database__MigrateOnly, value: 'true'}
          resources:
            requests: {cpu: 100m, memory: 192Mi}
            limits: {cpu: 750m, memory: 512Mi}
          securityContext:
            allowPrivilegeEscalation: false
            capabilities: {drop: [ALL]}
